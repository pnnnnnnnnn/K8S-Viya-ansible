    regexp: '\{\{\s*PYTHON-EXE-DIR\s*\}\}/\{\{\s*PYTHON-EXECUTABLE\s*\}\}'
    replace: "{{ python_install_path }}/bin/python{{ python_version }}"

- name: 22.1 修改 r-transformer.yaml 中的 VOLUME-ATTRIBUTES (代入 r_nfs_path 與 registry_ip)
  ansible.builtin.replace:
