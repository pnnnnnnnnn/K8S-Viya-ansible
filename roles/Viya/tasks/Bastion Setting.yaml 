- name: 23.1 複製 sas-audit 範例資料夾至 site-config
  ansible.builtin.copy:
    src: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/sas-bases/examples/sas-audit"
    dest: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/site-config/"
    remote_src: yes

- name: 23.2 修改 sas-audit/resources.yaml 中的 storage 容量為 1Gi
  ansible.builtin.replace:
    path: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/site-config/sas-audit/resources.yaml"
    regexp: 'storage:\s*.*#.*Change this to desired capacity\.'
    replace: 'storage: 1Gi'

- name: 23.3 修改 sas-audit/resources.yaml 中的 storageClassName 為 sassc
  ansible.builtin.replace:
    path: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/site-config/sas-audit/resources.yaml"
    regexp: 'storageClassName:\s*.*#.*Change this the desired storage class\.'
    replace: 'storageClassName: sassc'

- name: 24.1 驗證 kustomize 版本
  ansible.builtin.shell: kustomize version
  register: kustomize_version_result
  changed_when: false

- name: 24.2 顯示 kustomize 版本結果
  ansible.builtin.debug:
    msg: "{{ kustomize_version_result.stdout_lines }}"

- name: 25.1 執行 kustomize build 產生 site.yaml
  ansible.builtin.shell: kustomize build -o site.yaml
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  register: kustomize_build_result
  changed_when: true

- name: 25.2 動態將 harbor_destination 插入 site.yaml 的 image 路徑中
  ansible.builtin.replace:
    path: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/site.yaml"
    regexp: '({{ registry_ip }})/viya-4-'
    replace: '\1/{{ harbor_destination }}/viya-4-'

- name: 部署前環境清理與 Namespace 重建
  block:
    - name: 1. 嘗試透過 site.yaml 清理舊資源（若有）
      ansible.builtin.shell: kubectl delete -f site.yaml --ignore-not-found=true
      args:
        chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
      ignore_errors: true
      changed_when: true

    - name: 2. 觸發刪除舊的 viya4lts Namespace（使用 --wait=false 避免 Ansible 卡住）
      ansible.builtin.shell: kubectl delete ns viya4lts --wait=false --ignore-not-found=true
      changed_when: true

    - name: 3. 檢查並強制清除卡在 Terminating 的 Namespace Finalizers（若存在）
      ansible.builtin.shell: |
        if kubectl get ns viya4lts &>/dev/null; then
          kubectl get ns viya4lts -o json | jq '.spec.finalizers = []' > /tmp/ns-clean.json
          kubectl replace --raw /api/v1/namespaces/viya4lts/finalize -f /tmp/ns-clean.json || true
        fi
      changed_when: true

    - name: 4. 確認 Namespace 是否已被完全移除
      ansible.builtin.shell: kubectl get ns viya4lts || echo "Namespace successfully removed or did not exist."
      changed_when: false

    - name: 5. 重新建立全新的 viya4lts Namespace
      ansible.builtin.shell: kubectl create ns viya4lts
      changed_when: true

- name: 26.1 套用 Cluster-API 資源 (主要是 CRD)
  ansible.builtin.shell: kubectl apply --selector="sas.com/admin=cluster-api" --server-side --force-conflicts -f site.yaml
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  changed_when: true

- name: 26.2 等待 CRD 完全建立與註冊完成
  ansible.builtin.shell: kubectl wait --for condition=established --timeout=60s -l "sas.com/admin=cluster-api" crd
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  changed_when: true

- name: 26.3 套用 Cluster-Wide 資源
  ansible.builtin.shell: kubectl apply --selector="sas.com/admin=cluster-wide" -f site.yaml
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  changed_when: true

- name: 26.4 套用 Cluster-Local 資源
  ansible.builtin.shell: kubectl apply --selector="sas.com/admin=cluster-local" -f site.yaml --prune
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  changed_when: true

- name: 26.5 套用 Namespace 資源
  ansible.builtin.shell: kubectl apply --selector="sas.com/admin=namespace" -f site.yaml --prune
  args:
    chdir: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy"
  changed_when: true