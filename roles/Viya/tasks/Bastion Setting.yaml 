    regexp: '\{\{\s*R-MOUNTPATH\s*\}\}'
    replace: "{{ r_nfs_path }}"

- name: 22.3 修改 r-transformer.yaml 
  ansible.builtin.replace:
    path: "/nfsshare01/lsrc/{{ customer_name }}/{{ viya_version }}/deploy/site-config/sas-open-source-config/r/r-transformer.yaml"
    regexp: '\{\{\s*R-HOMEDIR\s*\}\}'
